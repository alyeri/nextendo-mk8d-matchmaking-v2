# mario-kart-8-deluxe — example configuration.
# Copy to ".env" and fill in real values. NEVER commit your real .env.

# --- Network ---
# Public IPv4 address advertised to clients. Do not include a port.
NEXTENDO_HOST=203.0.113.10
AUTH_PORT=443
SECURE_PORT=60003
CERT_FILE=/data/cert.pem
KEY_FILE=/data/key.pem
# Development/staging only: generate a self-signed certificate if files are absent.
NEXTENDO_AUTO_CERT=0
# Set to 1 if this server sits behind a proxy that speaks the PROXY protocol.
NEXTENDO_PROXY_PROTOCOL=0

# Matchmaking policy. Keep attribute matching at 0 until captured MK8DX
# attributes have been classified; raising it separates pools by that prefix.
MATCHMAKING_COMPAT_ATTRIBUTES=0
MATCHMAKING_RESERVATION_SECONDS=8
MATCHMAKING_RECONNECT_GRACE_SECONDS=20
MATCHMAKING_RELAX_AFTER_SECONDS=8
MATCHMAKING_SEARCH_IDLE_SECONDS=120
MATCHMAKING_SESSION_IDLE_SECONDS=1200
MATCHMAKING_INTERMISSION_GRACE_SECONDS=20
MATCHMAKING_JANITOR_SECONDS=15
MATCHMAKING_DEDUP_SECONDS=20
MATCHMAKING_QUALITY_WEIGHT=3
# Keep off until MK8D's client-side pre-race host migration is classified.
MATCHMAKING_PRE_RACE_HOST_SELECTION=0
# Conservative control-plane abuse protection. These limits do not apply to
# P2P race packets, NAT probes, keep-alives, or server notifications.
AUTH_RATE_LIMIT_PER_MINUTE=30
AUTH_RATE_BLOCK_SECONDS=30
MATCHMAKING_RATE_LIMIT_PER_10_SECONDS=300
MATCHMAKING_EXPENSIVE_LIMIT_PER_10_SECONDS=40
MATCHMAKING_RATE_BLOCK_SECONDS=10

# --- Nextendo account integration ---
# URL of the Nextendo account API used to resolve identities.
NEXTENDO_ACCOUNT_URL=https://nextendo.network
# Require a valid Nextendo account to play online (1 = enforce, 0 = allow guests).
NEXTENDO_REQUIRE_ACCOUNT=1
# Require a cryptographically signed nx2 proof inside LoginEx (recommended).
# Set to 0 only during migration for clients that do not yet send the nnex claim.
NEXTENDO_REQUIRE_SIGNED_TOKEN=1

# --- Secrets (set these to strong random values in production) ---
# Shared key for internal service-to-service calls.
NEXTENDO_INTERNAL_KEY=change-me
# Token-signing / verification secret. Either set the value directly...
NEXTENDO_SECRET=change-me
# ...or point to a file that contains it (takes precedence if set).
NEXTENDO_SECRET_FILE=
# Kerberos password shared between the auth and secure endpoints.
NEXTENDO_SECURE_PASSWORD=change-me
# SNI hostname advertised on the monitoring dashboard (cosmetic; leave empty if unused).
NEXTENDO_SNI_HOST=
NEXTENDO_DATA_DIR=/data

# --- Private administration API ---
# Keep this on loopback. Access it through an SSH tunnel or an authenticated
# reverse proxy. Requests use Authorization: Bearer <DASH_TOKEN>.
DASH_BIND=127.0.0.1
DASH_PORT=8082
DASH_TOKEN=change-me

# --- Redis state mirror (optional) ---
# Leave REDIS_URL empty to run entirely in memory. Redis stores expiring room,
# presence, service-health and connection-event data; it is not yet the
# authoritative matchmaking database.
REDIS_URL=
REDIS_REQUIRED=0
REDIS_KEY_PREFIX=nextendo:mk8d
REDIS_STATE_TTL_SECONDS=30
REDIS_SYNC_INTERVAL_SECONDS=5
NEXTENDO_INSTANCE_ID=mk8d-1

# --- NNCS / NAT observation ---
NNCS_LISTEN_IP=0.0.0.0
NNCS_PUBLIC_IP=203.0.113.10
NNCS_PROBE_PORTS=10025,10125
NNCS_SILENT_PORT=33334
NNCS_FILTER_PROBE_PORT=50920
NNCS_NAT_FILE=/data/nncs-nat-observations.txt
