# Copy to .env and replace every change-me value. Never commit real secrets.

# Public address advertised to clients (IP/hostname only, no port).
NEXTENDO_HOST=203.0.113.10
AUTH_PORT=443
SECURE_PORT=60003
CERT_FILE=/run/nextendo/cert.pem
KEY_FILE=/run/nextendo/key.pem
# Enable only behind a trusted proxy that sends PROXY protocol.
NEXTENDO_PROXY_PROTOCOL=0

# Nextendo account integration.
NEXTENDO_ACCOUNT_URL=https://nextendo.network
NEXTENDO_REQUIRE_ACCOUNT=1
NEXTENDO_REQUIRE_SIGNED_TOKEN=1
NEXTENDO_INTERNAL_KEY=change-me
# Inline raw signing secret, or leave empty and configure NEXTENDO_SECRET_FILE.
NEXTENDO_SECRET=change-me
NEXTENDO_SECRET_FILE=

# Incremental reliability changes in this branch.
MATCHMAKING_DEDUP_SECONDS=20
MATCHMAKING_DEDUP_MAX_ENTRIES=4096
MATCHMAKING_RESERVATION_SECONDS=8

# Inherited monitoring dashboard. Keep it private and always configure a token.
DASH_PORT=8082
DASH_TOKEN=change-me
NEXTENDO_GHOST_IDLE_SECONDS=900

# Inherited title-specific switches. Preserve conservative production defaults.
NEXTENDO_OPEN_PARTICIPATION=0
NEX_SOLO_PIDS=
