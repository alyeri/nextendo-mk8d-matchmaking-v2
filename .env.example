# Copy to .env and replace every CHANGE_ME value. Never commit .env or private keys.

# Public address advertised to clients (IP/hostname only; no port).
NEXTENDO_HOST=203.0.113.10
AUTH_PORT=443
SECURE_PORT=60003
CERT_FILE=/run/nextendo/cert.pem
KEY_FILE=/run/nextendo/key.pem
NEXTENDO_PROXY_PROTOCOL=0

# Nextendo account integration.
NEXTENDO_ACCOUNT_URL=https://nextendo.network
NEXTENDO_REQUIRE_ACCOUNT=1
NEXTENDO_REQUIRE_SIGNED_TOKEN=1
NEXTENDO_INTERNAL_KEY=CHANGE_ME_RANDOM_INTERNAL_KEY
NEXTENDO_SECRET=CHANGE_ME_SHARED_NX2_SECRET
NEXTENDO_SECRET_FILE=

# This integration branch only.
MATCHMAKING_DEDUP_SECONDS=20
MATCHMAKING_DEDUP_MAX_ENTRIES=4096
MATCHMAKING_RESERVATION_SECONDS=8

# Inherited dashboard. Compose publishes it on host loopback only.
DASH_PORT=8082
DASH_TOKEN=CHANGE_ME_RANDOM_DASHBOARD_TOKEN
NEXTENDO_GHOST_IDLE_SECONDS=900

# Preserve the upstream defaults unless a title-specific staging test requires otherwise.
NEXTENDO_OPEN_PARTICIPATION=0
NEX_SOLO_PIDS=
